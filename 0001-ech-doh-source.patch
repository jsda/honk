+/// Decode a base64 ECHConfigList with the outbound decoder's acceptance:
+/// standard or URL-safe alphabet, padded or unpadded, whitespace ignored.
+/// `None` for anything else, including the empty string.
+fn decode_ech_config_list(encoded: &str) -> Option<Vec<u8>> {
+    use base64::Engine as _;
+    let cleaned: String = encoded.chars().filter(|c| !c.is_whitespace()).collect();
+    for engine in [
+        &base64::engine::general_purpose::STANDARD,
+        &base64::engine::general_purpose::URL_SAFE,
+    ] {
+        if let Ok(bytes) = engine.decode(&cleaned) {
+            return (!bytes.is_empty()).then_some(bytes);
+        }
+    }
+    let trimmed = cleaned.trim_end_matches('=');
+    for engine in [
+        &base64::engine::general_purpose::STANDARD_NO_PAD,
+        &base64::engine::general_purpose::URL_SAFE_NO_PAD,
+    ] {
+        if let Ok(bytes) = engine.decode(trimmed) {
+            return (!bytes.is_empty()).then_some(bytes);
+        }
+    }
+    None
+}
+
+/// Classify an Xray `echConfigList` value into the download peer's
+/// `(ech_config, ech_doh)`: a dynamic `<qname>[+<doh-url>]` source, or a
+/// static base64 ECHConfigList. The grammars are disjoint — dynamic
+/// values always contain `.` or `:`, neither of which exists in either
+/// base64 alphabet — so trying dynamic first cannot steal a static value.
+fn classify_download_ech(raw: &str) -> Result<(Option<String>, Option<String>), &'static str> {
+    let raw = raw.trim();
+    if TlsOptions::parse_ech_doh(raw).is_ok() {
+        return Ok((None, Some(raw.to_string())));
+    }
+    if decode_ech_config_list(raw).is_some() {
+        return Ok((Some(raw.to_string()), None));
+    }
+    Err("unsupported XHTTP download settings")
+}
