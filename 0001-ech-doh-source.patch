+#[test]
+fn parse_bare_qname_uses_bootstrap_dns() {
+    let EchSource::Discover(qname) = parse_ech_source("cloudflare-ech.com").unwrap() else {
+        panic!("expected Discover");
+    };
+    assert_eq!(qname, "cloudflare-ech.com");
+}
