+#[test]
+fn parse_normalizes_qname_and_keeps_url_parts() {
+    let EchSource::Doh(source) =
+        parse_ech_source("  Example.COM.+https://doh.example:8443/dns-query?dns=abc ").unwrap()
+    else {
