+    assert_eq!(tls.ech_config.as_deref(), Some("AAECAw=="));
+    assert!(tls.ech_doh.is_none());
+    // The upload side is untouched: download ECH is never inherited
+    // in either direction.
+    assert!(node.tls().unwrap().ech_config.is_none());
+
+    // Dynamic: <qname>+<doh-url> selects the DoH source.
+    let node = with_ech("cloudflare-ech.com+https://223.5.5.5/dns-query");
+    let download = node
+        .transport()
+        .unwrap()
+        .xhttp
+        .as_ref()
+        .unwrap()
+        .download
+        .as_deref()
+        .unwrap();
+    assert_eq!(
+        download.ech_doh.as_deref(),
+        Some("cloudflare-ech.com+https://223.5.5.5/dns-query")
+    );
+    assert!(download.ech_config.is_none());
+    let view = node.xhttp_download_view().unwrap();
+    let tls = view.tls().unwrap();
+    assert!(tls.ech_enabled);
+    assert_eq!(
+        tls.ech_doh.as_deref(),
+        Some("cloudflare-ech.com+https://223.5.5.5/dns-query")
+    );
+
+    // A bare qname selects dynamic fetch through the bootstrap DNS path.
+    let node = with_ech("cloudflare-ech.com");
+    let download = node
+        .transport()
+        .unwrap()
+        .xhttp
+        .as_ref()
+        .unwrap()
+        .download
+        .as_deref()
+        .unwrap();
+    assert_eq!(download.ech_doh.as_deref(), Some("cloudflare-ech.com"));
+
+    // ECH on the download peer is part of the node's dial shape: the ID
+    // changes with it, while a download without ECH keeps the old ID
+    // (covered by download_settings_map_to_an_uninherited_download_peer).
+    let plain = download_link(json!({"downloadSettings": download_settings()}), "").unwrap();
+    assert_ne!(node.id, plain.id);
+}
